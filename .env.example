# Server Configuration
PORT=5000
NODE_ENV=development
INSTANCE_ID=instance-1

# Database Configuration
MONGODB_URI=mongodb://localhost:27017/eventsphere

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT Secrets & Expiration
JWT_ACCESS_SECRET=eventsphere_super_secret_access_jwt_key_2026_production_grade
JWT_REFRESH_SECRET=eventsphere_super_secret_refresh_jwt_key_2026_production_grade
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# CORS & Client
CORS_ORIGIN=http://localhost:5173,http://localhost:80,http://localhost:3000,http://localhost:8080

# Security & Secrets
PAYMENT_WEBHOOK_SECRET=eventsphere_payment_webhook_secret_key_2026
TICKET_HMAC_SECRET=eventsphere_ticket_hmac_secret_key_2026

# Optional External AI API Key (Gemini)
# If empty, EventSphere's built-in intelligent NLP assistant will handle queries locally.
GEMINI_API_KEY=
